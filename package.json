    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.26.0",
    "next": "14.2.3",
    "next-swagger-doc": "^0.4.0",
    "nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "swagger-ui-react": "^5.17.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
