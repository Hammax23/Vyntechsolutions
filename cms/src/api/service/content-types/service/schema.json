{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "01. Services",
    "description": "Service pages: web, mobile, SEO, cloud, and more"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "cardImage": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "heroVariant": {
      "type": "enumeration",
      "enum": [
        "browser",
        "mobile",
        "cloud",
        "devops",
        "aiml",
        "uiux",
        "ecommerce",
        "custom",
        "seo",
        "maintenance",
        "tax"
      ],
      "default": "browser"
    },
    "heroCtaLabel": {
      "type": "string"
    },
    "overview": {
      "type": "richtext"
    },
    "overviewTagline": {
      "type": "text"
    },
    "featuresEyebrow": {
      "type": "string"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.named-item"
    },
    "technologies": {
      "type": "json"
    },
    "processHeading": {
      "type": "string"
    },
    "processDescription": {
      "type": "text"
    },
    "process": {
      "type": "component",
      "repeatable": true,
      "component": "shared.process-step"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "caseStudies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.case-study"
    },
    "caseStudiesHeading": {
      "type": "string",
      "default": "Case Studies"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "whyChooseUsHeading": {
      "type": "string"
    },
    "whyChooseUsIntro": {
      "type": "richtext"
    },
    "whyChooseUsSubHeading": {
      "type": "string"
    },
    "whyChooseUsSubText": {
      "type": "richtext"
    },
    "whyChooseUsCards": {
      "type": "component",
      "repeatable": true,
      "component": "sections.value-card"
    },
    "deliveryEyebrow": {
      "type": "string"
    },
    "deliveryHeading": {
      "type": "string"
    },
    "deliveryDescription": {
      "type": "text"
    },
    "deliverySteps": {
      "type": "component",
      "repeatable": true,
      "component": "sections.delivery-step"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq"
    },
    "faqEyebrow": {
      "type": "string",
      "default": "FAQ"
    },
    "faqHeading": {
      "type": "string",
      "default": "Frequently asked questions"
    },
    "faqIntro": {
      "type": "text",
      "default": "Answers about how we work, timelines, and delivery. Still stuck? Chat with the team."
    },
    "ctaHeading": {
      "type": "string"
    },
    "ctaBody": {
      "type": "text"
    },
    "ctaButtonLabel": {
      "type": "string"
    },
    "showTechStack": {
      "type": "boolean",
      "default": true
    },
    "techStack": {
      "type": "json"
    },
    "pageSections": {
      "type": "json"
    },
    "seoPackagesBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.seo-packages-block"
    },
    "cloudIncludedBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.cloud-included-block"
    },
    "aiMlGridBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.ai-ml-grid-block"
    },
    "devopsGridBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.devops-grid-block"
    },
    "ecommerceServicesBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.ecommerce-services-block"
    },
    "uiuxEngagementsBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.uiux-engagements-block"
    },
    "mobileTabsBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.mobile-tabs-block"
    },
    "techStackBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.tech-stack-block"
    },
    "localSeoBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.local-seo-block"
    },
    "canadaCitiesBlock": {
      "type": "component",
      "repeatable": false,
      "component": "sections.canada-cities-block"
    },
    "cityHero": {
      "type": "component",
      "repeatable": false,
      "component": "sections.city-hero"
    },
    "engagementStrategies": {
      "type": "component",
      "repeatable": true,
      "component": "sections.engagement-strategy"
    },
    "cityFaqs": {
      "type": "component",
      "repeatable": true,
      "component": "sections.city-faq"
    },
    "canadaCities": {
      "type": "json"
    }
  }
}
