{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "01. Services",
    "description": "Service pages: web, mobile, SEO, cloud, and more"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "cardImage": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "heroVariant": {
      "type": "enumeration",
      "enum": [
        "browser",
        "mobile",
        "cloud",
        "devops",
        "aiml",
        "uiux",
        "ecommerce",
        "custom",
        "seo",
        "maintenance",
        "tax"
      ],
      "default": "browser"
    },
    "heroCtaLabel": {
      "type": "string"
    },
    "overview": {
      "type": "richtext"
    },
    "overviewTagline": {
      "type": "text"
    },
    "featuresEyebrow": {
      "type": "string"
    },
    "features": {
      "type": "component",
      "repeatable": true,
      "component": "shared.named-item"
    },
    "technologies": {
      "type": "json"
    },
    "processHeading": {
      "type": "string"
    },
    "processDescription": {
      "type": "text"
    },
    "process": {
      "type": "component",
      "repeatable": true,
      "component": "shared.process-step"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "caseStudies": {
      "type": "component",
      "repeatable": true,
      "component": "shared.case-study"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "whyChooseUsHeading": {
      "type": "string"
    },
    "whyChooseUsIntro": {
      "type": "text"
    },
    "whyChooseUsSubHeading": {
      "type": "string"
    },
    "whyChooseUsSubText": {
      "type": "text"
    },
    "whyChooseUsCards": {
      "type": "component",
      "repeatable": true,
      "component": "sections.value-card"
    },
    "deliveryEyebrow": {
      "type": "string"
    },
    "deliveryHeading": {
      "type": "string"
    },
    "deliveryDescription": {
      "type": "text"
    },
    "deliverySteps": {
      "type": "component",
      "repeatable": true,
      "component": "sections.delivery-step"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq"
    },
    "ctaHeading": {
      "type": "string"
    },
    "ctaBody": {
      "type": "text"
    },
    "ctaButtonLabel": {
      "type": "string"
    },
    "showTechStack": {
      "type": "boolean",
      "default": true
    },
    "techStack": {
      "type": "json"
    },
    "pageSections": {
      "type": "json"
    },
    "canadaCities": {
      "type": "json"
    }
  }
}
