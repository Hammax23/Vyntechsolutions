{
  "kind": "singleType",
  "collectionName": "homepages",
  "info": {
    "singularName": "homepage",
    "pluralName": "homepages",
    "displayName": "01. Homepage",
    "description": "Main homepage hero, services intro, and impact content"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroSlides": {
      "type": "component",
      "repeatable": true,
      "component": "home.hero-slide"
    },
    "heroCtaLabel": {
      "type": "string"
    },
    "heroWords": {
      "type": "json"
    },
    "servicesHeading": {
      "type": "string"
    },
    "servicesSubheading": {
      "type": "string"
    },
    "servicesBody": {
      "type": "richtext"
    },
    "serviceCards": {
      "type": "component",
      "repeatable": true,
      "component": "home.service-card"
    },
    "servicesLearnMoreLabel": {
      "type": "string",
      "default": "Learn More"
    },
    "impactEyebrow": {
      "type": "string"
    },
    "impactHeading": {
      "type": "string"
    },
    "impactBody": {
      "type": "richtext"
    },
    "impactStats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "impactCtaLabel": {
      "type": "string"
    },
    "impactCtaHref": {
      "type": "string"
    },
    "insightsEyebrow": {
      "type": "string"
    },
    "insightsHeading": {
      "type": "string"
    },
    "insightsIntro": {
      "type": "richtext"
    },
    "insightsVideoUrl": {
      "type": "string",
      "default": "/meeting.mp4"
    },
    "insightsViewAllLabel": {
      "type": "string",
      "default": "View all insights"
    },
    "insightsViewAllHref": {
      "type": "string",
      "default": "/blog"
    },
    "industriesHeading": {
      "type": "string"
    },
    "industriesSubheading": {
      "type": "string"
    },
    "industriesViewLabel": {
      "type": "string",
      "default": "View"
    },
    "partnersHeading": {
      "type": "string",
      "default": "Technology Partners"
    },
    "partnersShowHeading": {
      "type": "boolean",
      "default": true
    },
    "faqEyebrow": {
      "type": "string"
    },
    "faqHeading": {
      "type": "string"
    },
    "faqIntro": {
      "type": "richtext"
    },
    "techStackEyebrow": {
      "type": "string"
    },
    "techStackHeading": {
      "type": "string"
    },
    "techStackBody": {
      "type": "richtext"
    },
    "techStack": {
      "type": "json"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
