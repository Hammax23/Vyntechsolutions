      "targetField": "title",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "icon": {
      "type": "string"
    },
    "cardImage": {
      "type": "string"
    },
    "solutionsEyebrow": {
      "type": "string"
    },
    "challengesHeading": {
      "type": "string"
    },
    "servicesHeading": {
      "type": "string"
    },
    "technologiesHeading": {
      "type": "string"
    },
    "heroCtaLabel": {
      "type": "string"
    },
    "heroStats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "challenges": {
      "type": "component",
      "repeatable": true,
      "component": "shared.named-item"
    },
    "services": {
      "type": "component",
      "repeatable": true,
      "component": "shared.named-item"
    },
    "technologies": {
      "type": "json"
    },
    "highlights": {
      "type": "json"
    },
    "whyChooseUsHeading": {
      "type": "string"
    },
    "whyChooseUsIntro": {
      "type": "richtext"
    },
    "whyChooseUsSubHeading": {
      "type": "string"
    },
    "whyChooseUsSubText": {
      "type": "richtext"
    },
    "whyChooseUsCards": {
      "type": "component",
      "repeatable": true,
      "component": "sections.value-card"
    },
    "faqs": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq"
    },
    "faqEyebrow": {
      "type": "string",
      "default": "FAQ"
    },
    "faqHeading": {
      "type": "string",
      "default": "Frequently asked questions"
    },
    "faqIntro": {
      "type": "text",
      "default": "Answers about how we work, timelines, and delivery. Still stuck? Chat with the team."
    },
    "ctaHeading": {
      "type": "string"
    },
    "ctaBody": {
      "type": "text"
    },
    "ctaButtonLabel": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "hero": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    },
    "heroImageUrl": {
      "type": "string"
    }
  }
}
