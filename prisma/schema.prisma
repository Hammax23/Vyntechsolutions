// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quote Submissions from contact form
model QuoteSubmission {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String
  companyName    String?
  companyUrl     String?
  services       String[]
  projectDetails String?
  hearAbout      String?
  status         String   @default("new")
  submittedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Projects
model Project {
  id           String   @id @default(cuid())
  projectName  String
  description  String?
  clientName   String
  clientEmail  String
  clientPhone  String
  companyName  String?
  services     String[]
  status       String   @default("discovery")
  priority     String   @default("medium")
  progress     Int      @default(0)
  budget       Float    @default(0)
  spent        Float    @default(0)
  startDate    DateTime?
  deadline     DateTime?
  teamMembers  String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        Task[]
  milestones   Milestone[]
  notes        Note[]
  activityLogs ActivityLog[]
}

// Tasks
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium")
  dueDate     DateTime?
  assignee    String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Milestones
model Milestone {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime?
  completed Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notes
model Note {
  id        String   @id @default(cuid())
  content   String
  author    String   @default("Admin")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Activity Logs
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  user      String   @default("Admin")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
}

// Admin Login Attempts (Rate Limiting)
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// 2FA Verification Codes
model TwoFactorCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Job Positions / Careers
model JobPosition {
  id            String   @id @default(cuid())
  title         String
  department    String
  location      String
  type          String   @default("Full-time") // Full-time, Part-time, Contract, Remote
  experience    String   // e.g., "2-4 years", "5+ years"
  salary        String?  // Optional salary range
  description   String
  requirements  String[] // List of requirements
  responsibilities String[] // List of responsibilities
  benefits      String[] // List of benefits
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Client quotations / offer letters (admin generator)
model ClientQuotation {
  id               String   @id @default(cuid())
  quoteNumber      String   @unique
  customerName     String
  companyName      String?
  quoteDate        DateTime @default(now())
  projectTitle     String
  projectSubtitle  String?
  introText        String?
  projectType      String?
  technology       String?
  totalPages       String?
  timeline         String?
  scopeSections    Json     @default("[]")
  includes         String[]
  optionalServices Json     @default("[]")
  showSocialMedia  Boolean  @default(true)
  socialMediaFee   Float    @default(600)
  socialIncludes   String[]
  baseAmount       Float
  discountPercent  Float    @default(10)
  hstPercent       Float    @default(13)
  depositPercent   Float    @default(50)
  terms            String[]
  status           String   @default("draft")
  shareToken       String?  @unique
  shareExpiresAt   DateTime?
  clientSelections Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Company expenses (salary slips & internal expense vouchers)
model ClientInvoice {
  id             String   @id @default(cuid())
  expenseType    String   @default("salary") // salary | expense
  documentNumber String   @unique
  issueDate      DateTime @default(now())
  payeeName      String
  payeeEmail     String?
  payeeRole      String?
  periodLabel    String?
  category       String?
  lineItems      Json     @default("[]")
  notes          String?
  paymentMethod  String?
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Client billing invoices (invoices issued TO clients)
model BillingInvoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  issueDate      DateTime @default(now())
  dueDate        DateTime?
  clientName     String
  companyName    String?
  clientEmail    String?
  clientPhone    String?
  clientAddress  String?
  projectTitle   String?
  lineItems      Json     @default("[]")
  discountPercent Float   @default(0)
  hstPercent     Float    @default(13)
  amountPaid     Float    @default(0)
  paymentMethod  String?
  paymentTerms   String?
  notes          String?
  status         String   @default("draft") // draft | sent | paid | overdue | cancelled
  projectId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Internal staff accounts for /workflow daily progress
model StaffUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("employee") // employee | system
  isActive     Boolean  @default(true)
  color        String   @default("#00B4FF")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTasks  WorkflowTask[] @relation("TaskCreator")
  assignedTasks WorkflowTask[] @relation("TaskAssignee")
}

model WorkflowTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("todo") // todo | in_progress | done | blocked
  priority     String    @default("medium") // low | medium | high
  workDate     DateTime
  dueAt        DateTime?
  createdById  String
  assignedToId String
  createdBy    StaffUser @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   StaffUser @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignedToId, workDate])
  @@index([createdById, workDate])
  @@index([workDate])
}
