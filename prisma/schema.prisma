// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quote Submissions from contact form
model QuoteSubmission {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String
  companyName    String?
  companyUrl     String?
  services       String[]
  projectDetails String?
  hearAbout      String?
  status         String   @default("new")
  submittedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Projects
model Project {
  id           String   @id @default(cuid())
  projectName  String
  description  String?
  clientName   String
  clientEmail  String
  clientPhone  String
  companyName  String?
  /// Public path to company logo (e.g. /uploads/project-logos/xxx.png)
  companyLogo  String?
  services     String[]
  /// SDLC phase: discovery | requirements | design | development | testing | deployment | support | seo | digital_marketing | completed | on_hold
  status       String   @default("discovery")
  priority     String   @default("medium")
  progress     Int      @default(0)
  budget       Float    @default(0)
  spent        Float    @default(0)
  startDate    DateTime?
  deadline     DateTime?
  teamMembers  String[]
  /// Sign-offs: [{ phase, signedOffAt, note }]
  phaseGates   Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks           Task[]
  milestones      Milestone[]
  notes           Note[]
  activityLogs    ActivityLog[]
  phaseChecks     ProjectPhaseCheck[]
  payments        ProjectPayment[]
  teamRoster      ProjectTeamMember[]
  workflowTasks   WorkflowTask[]
  clientUpdates   ProjectClientUpdate[]
  billingInvoices BillingInvoice[]
}

/// Email status updates sent to the client from Project Manager
model ProjectClientUpdate {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentTo         String
  subject        String
  messageNote    String?
  snapshot       Json
  kind           String   @default("client") // client | test
  status         String   @default("sent") // sent | failed
  errorMessage   String?
  idempotencyKey String   @unique
  bccTo          String?
  sentBy         String   @default("Admin")
  createdAt      DateTime @default(now())

  @@index([projectId, createdAt])
}

/// Staff assigned to a client project (for Workflow assign from Project Manager)
model ProjectTeamMember {
  id          String    @id @default(cuid())
  projectId   String
  staffUserId String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([projectId, staffUserId])
  @@index([staffUserId])
}

/// Per-phase checklist items (seeded from Our Project Workflow PDF)
model ProjectPhaseCheck {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     String
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, phase])
}

/// Payment milestones (default 40% / 30% / 30%)
model ProjectPayment {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  percent   Float
  amount    Float     @default(0)
  status    String    @default("pending") // pending | due | paid
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  billingInvoice BillingInvoice?

  @@index([projectId])
}

// Tasks
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium")
  dueDate     DateTime?
  assignee    String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Milestones
model Milestone {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime?
  completed Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Notes
model Note {
  id        String   @id @default(cuid())
  content   String
  author    String   @default("Admin")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Activity Logs
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  user      String   @default("Admin")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
}

// Admin Login Attempts (Rate Limiting)
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  email     String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// 2FA Verification Codes
model TwoFactorCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Job Positions / Careers
model JobPosition {
  id            String   @id @default(cuid())
  title         String
  department    String
  location      String
  type          String   @default("Full-time") // Full-time, Part-time, Contract, Remote
  experience    String   // e.g., "2-4 years", "5+ years"
  salary        String?  // Optional salary range
  description   String
  requirements  String[] // List of requirements
  responsibilities String[] // List of responsibilities
  benefits      String[] // List of benefits
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Client quotations / offer letters (admin generator)
model ClientQuotation {
  id               String   @id @default(cuid())
  quoteNumber      String   @unique
  customerName     String
  companyName      String?
  quoteDate        DateTime @default(now())
  projectTitle     String
  projectSubtitle  String?
  introText        String?
  projectType      String?
  technology       String?
  totalPages       String?
  timeline         String?
  scopeSections    Json     @default("[]")
  includes         String[]
  optionalServices Json     @default("[]")
  showSocialMedia  Boolean  @default(true)
  socialMediaFee   Float    @default(600)
  socialIncludes   String[]
  baseAmount       Float
  discountPercent  Float    @default(10)
  hstPercent       Float    @default(13)
  depositPercent   Float    @default(50)
  terms            String[]
  status           String   @default("draft")
  shareToken       String?  @unique
  shareExpiresAt   DateTime?
  clientSelections Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Company expenses (salary slips & internal expense vouchers)
model ClientInvoice {
  id             String   @id @default(cuid())
  expenseType    String   @default("salary") // salary | expense
  documentNumber String   @unique
  issueDate      DateTime @default(now())
  payeeName      String
  payeeEmail     String?
  payeeRole      String?
  periodLabel    String?
  category       String?
  lineItems      Json     @default("[]")
  notes          String?
  paymentMethod  String?
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Client billing invoices (invoices issued TO clients)
model BillingInvoice {
  id                      String    @id @default(cuid())
  invoiceNumber           String    @unique
  issueDate               DateTime  @default(now())
  dueDate                 DateTime?
  clientName              String
  companyName             String?
  clientEmail             String?
  clientPhone             String?
  clientAddress           String?
  projectTitle            String?
  lineItems               Json      @default("[]")
  discountPercent         Float     @default(0)
  hstPercent              Float     @default(13)
  amountPaid              Float     @default(0)
  paymentMethod           String?
  paymentTerms            String?
  notes                   String?
  status                  String    @default("draft") // draft | sent | paid | overdue | cancelled
  projectId               String?
  project                 Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectPaymentId        String?   @unique
  projectPayment          ProjectPayment? @relation(fields: [projectPaymentId], references: [id], onDelete: SetNull)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  checkoutUrl             String?
  paidAt                  DateTime?
  sentAt                  DateTime?
  sentTo                  String?
  lastSendError           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  events                  BillingInvoiceEvent[]

  @@index([projectId])
  @@index([status, dueDate])
}

model BillingInvoiceEvent {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([invoiceId, createdAt])
}

/// Stripe webhook idempotency
model StripeWebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// Internal staff accounts for /workflow daily progress
model StaffUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("employee") // employee | system
  isActive     Boolean  @default(true)
  color        String   @default("#00B4FF")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTasks  WorkflowTask[] @relation("TaskCreator")
  assignedTasks WorkflowTask[] @relation("TaskAssignee")
  attachments   WorkflowAttachment[]
  projectTeams  ProjectTeamMember[]
}

model WorkflowTask {
  id              String    @id @default(cuid())
  title           String
  description     String?
  /// Optional URL to the page/work the employee worked on (e.g. site About page)
  workLink        String?
  status          String    @default("todo") // todo | in_progress | done | blocked
  priority        String    @default("medium") // low | medium | high
  workDate        DateTime
  dueAt           DateTime?
  createdById     String
  assignedToId    String
  /// Optional link to client Project (Project Manager ↔ Workflow)
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy       StaffUser @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo      StaffUser @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  /// When the current status segment started
  statusChangedAt DateTime  @default(now())
  /// Start of the current To do → Done attempt (resets if reopened from Done)
  cycleStartedAt  DateTime  @default(now())
  /// First time the task entered in_progress (this cycle)
  startedAt       DateTime?
  /// When the task entered done (cleared if reopened)
  completedAt     DateTime?
  /// First time the task entered blocked (this cycle)
  firstBlockedAt  DateTime?
  /// Accumulated milliseconds spent in each status this cycle (closed segments only)
  todoMs          Int       @default(0)
  inProgressMs    Int       @default(0)
  blockedMs       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  attachments     WorkflowAttachment[]

  @@index([assignedToId, workDate])
  @@index([createdById, workDate])
  @@index([workDate])
  @@index([projectId, workDate])
}

model WorkflowAttachment {
  id           String      @id @default(cuid())
  taskId       String
  task         WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   StaffUser   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  /// Original file name shown in the UI
  fileName     String
  /// Safe name on disk under uploads/workflow
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime    @default(now())

  @@index([taskId])
  @@index([uploadedById])
}
